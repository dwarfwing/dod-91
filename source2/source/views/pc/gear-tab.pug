mixin gear-tab 
   .tab-gear
      +checkbox({name:'show animal tab',value:1,class:'animal-show hidden'})
      +checkbox({name:'show herbs drugs',value:0,class:'herbs-drugs-hide hidden'}) 
      +checkbox({name:'show herbs drugs',value:1,class:'herbs-drugs-middle hidden'}) 
      +checkbox({name:'show herbs drugs',value:2,class:'herbs-drugs-right hidden'}) 
      +checkbox({name:'show animal gear',value:0,class:'animal-gear-hide hidden'}) 
      +checkbox({name:'show animal gear',value:1,class:'animal-gear-middle hidden'}) 
      +checkbox({name:'show animal gear',value:2,class:'animal-gear-right hidden'}) 
      +checkbox({name:'show gear storage',value:0,class:'storage-gear-hide hidden'}) 
      +checkbox({name:'show gear storage',value:1,class:'storage-gear-middle hidden'}) 
      +checkbox({name:'show gear storage',value:2,class:'storage-gear-right hidden'}) 
      //-+encumbrance 
      +gear({name:'Utrustning',attr:'gear',move:['Storage','Animal','Herbsndrugs']})
      .column2.section-gear__col2
         +gear({name:'Förvar',attr:'storage',move:['Gear','Animal','Herbsndrugs']})
         +gear({name:'Droger, örter, etc',attr:'herbsndrugs',move:['Gear','Storage','Animal']}) 
         +gear({name:'Riddjur',attr:'animal',move:['Gear','Storage','Herbsndrugs']}) 
      .column3.section-gear__col3
         +money
         +gear({name:'Förvar',attr:'storage',move:['Gear','Animal','Herbsndrugs']})
         +gear({name:'Riddjur',attr:'animal',move:['Gear','Storage','Herbsndrugs']}) 
         +gear({name:'Droger, örter, etc',attr:'herbsndrugs',move:['Gear','Storage','Animal']}) 
+scss.
   .tab-gear {
      display: grid;       
      grid-template-columns: 1fr 1fr 1fr;
      //grid-template-areas: "gear stash col3"
      //                     "gear stash col3";
      //.section-encumbrance { grid-area: encumb; }
      //.section-gear__gear { grid-area: gear; }
      //.section-gear__col3 { grid-area: col3; }
      //.section-gear__animal { grid-area: animal; }
      //.section-gear__stash { grid-area: stash; }
      //.section-money { grid-area: money; }
      .animal-show:not(:checked) ~ .column3 .section-gear__animal { display: none; }
      .animal-show:not(:checked) ~ :is(.section-gear,.column2,.column3) .move-buttons .move-to-animal { display: none; }
      .herbs-drugs-hide:checked ~ :is(.column2,.column3) .section-gear__herbsndrugs { display: none; }
      .herbs-drugs-middle:checked ~ .column3 .section-gear__herbsndrugs { display: none; }
      .herbs-drugs-right:checked ~ .column2 .section-gear__herbsndrugs { display: none; }
      .animal-gear-hide:checked ~ :is(.column2,.column3) .section-gear__animal { display: none; }
      .animal-gear-middle:checked ~ .column3 .section-gear__animal { display: none; }
      .animal-gear-right:checked ~ .column2 .section-gear__animal { display: none; }
      .storage-gear-hide:checked ~ :is(.column2,.column3) .section-gear__storage { display: none; }
      .storage-gear-middle:checked ~ .column3 .section-gear__storage { display: none; }
      .storage-gear-right:checked ~ .column2 .section-gear__storage { display: none; }
   }