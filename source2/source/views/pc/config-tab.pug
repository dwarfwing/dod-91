mixin config-tab
   .section-config 
      +box({headerObj:{name:'Formulär',attr:'sheetsettings','data-i18n':'sheet-settings'},classes:''})
         +input-label({
            label: 'Visa djur-tabben',
            spanObj:{'data-i18n':'show-animal-tab'},
            divObj:{class:''},
            inputObj:{name:'show animal tab',type:'checkbox',value:1,checked:true}
            })
         +input-label({
            label: 'Visa Magi-tabben',
            spanObj:{'data-i18n':'show-magic-tab'},
            divObj:{class:''},
            inputObj:{name:'show magic tab',type:'checkbox',value:1,checked:true}
            })
         +input-label({
            label: 'Visa Noteringar-tabben',
            spanObj:{'data-i18n':'show-notes-tab'},
            divObj:{class:''},
            inputObj:{name:'show notes tab',type:'checkbox',value:1,checked:true}
            })
         +input-label({
            label: 'Visa Vapentekniker i Strid-tabben',
            spanObj:{'data-i18n':'show-weapon-techniques'},
            divObj:{class:''},
            inputObj:{name:'show weapon techniques',type:'checkbox',value:1,checked:true}
            })
         +select-label({
            label: 'Visa Stridskonster i Strid-tabben',
            spanObj:{'data-i18n':'show-martial-arts'},
            divObj:{class:''},
            inputObj:{name:'show martial arts',value:1}
            })
            +option({value:0,})
               |0
            +option({value:1,selected:''})
               |1
            +option({value:2})
               |2
            +option({value:3})
               |3
         label(data+i18n="house-magic-cost").input-label.header-label Husregler för besvärjelsekostnad
         +input-label({
            label: 'Ingen huregel för kostnad',
            spanObj:{'data-i18n':'house-magic-cost-no',title:'Ingen husregel för kostnad av besvärjelser.','data-i18n-title':'house-half-cost-magic-no'},
            divObj:{class:'indented'},
            inputObj:{name:'house_magic_costs',type:'radio',value:0}
            })
         +input-label({
            label: 'Halv kostnad upp till SV 10',
            spanObj:{'data-i18n':'house-magic-cost-sv10',title:'Husregel: Halva kostnaden för besvärjelser upp till och med Skolvärde 10.','data-i18n-title':'house-half-cost-magic-sv10'},
            divObj:{class:'indented'},
            inputObj:{name:'house_magic_costs',type:'radio',value:1,checked:true,selected:true}
            })
         +input-label({
            label: 'Halv kostnad upp till S 10',
            spanObj:{'data-i18n':'house-magic-cost-s10',title:'Husregel: Halva kostnaden för besvärjelser upp till och med Skicklighet 10.','data-i18n-title':'house-half-cost-magic-s10'},
            divObj:{class:'indented'},
            inputObj:{name:'house_magic_costs',type:'radio',value:2}
            })
      +box({headerObj:{name:'Karaktär',attr:'character settings','data-i18n':'character-settings'},classes:'coverall'})
         +input-label({
            label: 'Kropppoäng modifikation',
            spanObj:{'data-i18n':'kp-modifier'},
            divObj:{class:''},
            inputObj:{name:'kp mod',type:'number',value:0,trigger:{triggeredFuncs:['calcHealthpoints']}}
            })
         +input-label({
            label: 'Smärtpoäng modifikation',
            spanObj:{'data-i18n':'sp-modifier'},
            divObj:{class:'show-sp'},
            inputObj:{name:'sp mod',type:'number',value:0,trigger:{triggeredFuncs:['calcPainpoints']}}
            })
         +input-label({
            label: 'PSY-poäng modifikation',
            spanObj:{'data-i18n':'psy-modifier'},
            divObj:{class:''},
            inputObj:{name:'psypoang mod',type:'number',value:0,trigger:{triggeredFuncs:['calcPsypoints']}}
            })
         +input-label({
            label: 'Bärförmåga modifikation',
            spanObj:{'data-i18n':'barformaga-modifier'},
            divObj:{class:''},
            inputObj:{name:'barformaga mod',type:'number',value:0,trigger:{triggeredFuncs:['calcEncumbranceMax']}}
            })
         +input-label({
            label: 'Förflyttning modifikation',
            spanObj:{'data-i18n':'movement-modifier'},
            divObj:{class:''},
            inputObj:{name:'movement mod',type:'number',value:0,trigger:{triggeredFuncs:['calcMovement']}}
            })
         +input-label({
            label: 'Skadebonus manuellt',
            spanObj:{'data-i18n':'sb-override'},
            divObj:{class:''},
            inputObj:{name:'sb mod',type:'text',trigger:{triggeredFuncs:['calcDamagebonus']}}
            })
+scss.
   .section-config {
      column-count: 2;
      column-gap: 0;
      .box {
         height: auto; 
         .input-label {
            width: 100%;
            border-bottom: 1px solid var(--border-color);
            line-height: 2rem;
            justify-content: space-between;
            height: 2rem;
            span {
               text-transform: none; 
            }
            input[type=checkbox] {
               margin-right: 1rem;
            }
            /*input[type=radio] {
               border: 1px solid var(--checkboxBorderColor);
               cursor: pointer;
               -webkit-appearance: none;
               appearance: none;
               width: var(--checkboxWidth);
               min-width: var(--checkboxWidth);
               height: var(--checkboxHeight);
               min-height: var(--checkboxHeight);
               display: grid;
               grid-template-columns: 1fr;
               grid-template-areas: "content";
               width: 1.175rem;
               aspect-ratio: 1 / 1;
               border: 1px solid black;
               border-radius: 40%;
               margin-right: 1rem;
               &:checked:before {
                  content: var(--checkContent);
                  grid-area: content;
                  font-weight: var(--checkWeight);
                  place-self: start center;
                  color: var(--checkColor);
                  font-size: var(--checkSize);
                  line-height: var(--checkLineHeight);
                  height: 1.175rem;
                  aspect-ratio: 1 / 1;
               }
            }*/
            input[type=number] {
               height: 100%; 
               border-left: 1px solid var(--border-color);
               border-radius: 0;
            }
            input[type=text] {
               width: 4rem; 
               flex: unset; 
               text-align: center; 
               height: 1.5rem; 
               align-self: center; 
               outline: 1px solid black; 
               corner-shape: bevel; 
            }
            select {
               appearance: auto;
               width: 3rem; 
               text-align: center; 
               option {
                  text-align: center;                    
               }
            }
            &.header-label {
               text-indent: 0.5rem; 
            }
            &.indented {
               padding-left: 1rem; 
            }
         }
      }
   }