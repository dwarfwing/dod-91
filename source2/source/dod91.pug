//- Now, for our actual sheet. We'll wrap this in a main element and give it an ID of main.
main#main
  .logo
  //-.roll
    +number({name:'dice count',value:1})
    //-span T 
    +select({name:'die size'})
      +option({value:'3'})
        | T3
      +option({value:'4'})
        | T4
      +option({value:'6',selected:'selected'})
        | T6
      +option({value:'8'})
        | T8
      +option({value:'10'})
        | T10
      +option({value:'10'})
        | T12
      +option({value:'20'})
        | T20
      +option({value:'100'})
        | T100
    +roller({name:'custom dice roll',class:'custom-roller',trigger:{triggeredFuncs:['customDiceRoll']}})
  .roll-alternatives
    +radio({name:'whisper',id:'toggle-roll-viz-normal',value:' ',class:'hidden'})
    label(for='toggle-roll-viz-normal',data-i18n-title='roll-normal-title')
      | visibility 
    +radio({name:'whisper',id:'toggle-roll-viz-whisper',value:'/w gm',class:'hidden'})
    label(for='toggle-roll-viz-whisper',data-i18n-title='roll-whispering-title')
      | visibility_lock 
    //-+radio({name:'whisper',id:'toggle-roll-viz-secret',value:'/sr',class:'hidden'})
    //-label(for='toggle-roll-viz-secret',data-i18n-title='roll-secret-title')
      | visibility_off 
    //-+radio({name:'whisper',id:'toggle-roll-viz-whisper',value:'/ssr',class:'hidden'})
    //-label(for='toggle-roll-viz-whisper',data-i18n-title='roll-super-secret-title')
      | disabled_visible 

  +tabs({name:'dod91',defaultActiveTab:'pc'}).flex-box.tiny-gap
    +tab({name:'pc',container:'article',button:{content:'Person_4',class:'tab-button',title:'PC','data-i18n-title':'pc-caps'}})
      +topframe   
      p(style="width:100%;")
      +tabs({name:'pctabs',defaultActiveTab:'skills'})
        +tab({name:'skills',container:'div',button:{content:'Färdigheter',class:'tab-button',title:'PC','data-i18n-title':'skills'}})
          +skills-tab
        +tab({name:'combat',container:'div',button:{content:'Strid',class:'tab-button',title:'combat','data-i18n-title':'combat'}})
          +combat-tab
        +tab({name:'magic',container:'div',button:{content:'Magi',class:'tab-button',title:'magic','data-i18n-title':'magic'}})
          +magic-tab
        +tab({name:'gear',container:'div',button:{content:'Utrustning',class:'tab-button',title:'gear','data-i18n-title':'gear'}})
          +gear-tab
        +tab({name:'animal',container:'div',button:{content:'Djur',class:'tab-button',title:'animal','data-i18n-title':'animal'}})
          +animal-tab
        +tab({name:'recovery',container:'div',button:{content:'Vila & Skador',class:'tab-button',title:'recovery','data-i18n-title':'recovery'}})
          +recovery-tab
        //-+tab({name:'notes',container:'div',button:{content:'Anteckningar',class:'tab-button',title:'notes','data-i18n-title':'notes'}})
          +notes-tab
    //-+tab({name:'npc',container:'article',button:{content:'Person_2',class:'tab-button',title:'NPC','data-i18n-title':'npc-caps'}})
      include ./views/npc/_index.pug
    //-+tab({name:'monster',container:'article',button:{content:'Pets',class:'tab-button',title:'Monster','data-i18n-title':'monster'}})
      include ./views/monster/_index.pug
    //-+tab({name:'vehicle',container:'article',button:{content:'directions_car',class:'tab-button',title:'Monster','data-i18n-title':'monster'}})
      include ./views/vehicle/_index.pug
    +tab({name:'animal',container:'article',button:{content:'chess_knight',class:'tab-button',title:'Djur','data-i18n-title':'animal'}})
      +animal-tab
    +tab({name:'settings',container:'article',button:{content:'Settings',class:'tab-button',title:'Settings','data-i18n-title':'settings'}})
      include ./views/settings/_index.pug
    //- Add additional tabs as needed
  //-.tabs.tabs--dod91.flex-box.tiny-gap
    .tabs__body.tabs--dod91__body
      article.tabs__container.tabs--dod91__container.tabs--dod91__container--pc.k-active-tab
        include ./views/pc/_index.pug
//- An input to contain template fields that should always be output with a roll.
+hidden({name:'templatestart',value:`@{whisper}&{template:${templateName}} {{character_name=@{character_name}}} {{character_id=@{character_id}}}`})
+hidden({name:'templatestartwhisper',value:`/w gm &{template:${templateName}} {{character_name=@{character_name}}} {{character_id=@{character_id}}}`})
+hidden({name:'whisper',value:``})
