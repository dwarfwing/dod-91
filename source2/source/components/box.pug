mixin box({headerObj={},fields=[],classes=""})
   - boxClass = classes; 
   if headerObj
      - headerName = headerObj.name ? headerObj.name : '';
      - boxClass += headerObj.attr ? " box-"+headerObj.attr : "";
   if fields
      //- fields = fields.isArray ? fields : [...fields];  
      - fieldCount = fields.length;
      //- boxClass += ' field-count-'+fieldCount;
   .box(class=boxClass)     
      .box-header(class='field-count-'+fieldCount) 
         if headerObj && headerObj.name 
            h1(data-i18n=headerObj['data-i18n']) 
               = headerName
         each field in fields
            - let transl = ''; 
            if field.transl 
               - transl = field.transl;
            else if field.attr 
               - transl = field.attr.replace(/_/g,'-');
            h2(data-i18n=transl,class='header-field')
               = field.name 
         //-+list({content})      
      block
+module.
+scss('sheet').
   .box {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      border: 0;
      border: var(--border-size) solid var(--border-color);
      box-sizing: border-box; 
      //min-width: 50%;
      //margin: 1rem;
      position: relative;
      background-color:  var(--bg-color2);
      &.topless, &.no-top-border { border-top: 0; }
      &.bottomless { border-bottom: 0; }
      .box-header {
         width: 100%;
         border-bottom: var(--border-size) solid var(--border-color);
         background-color: var(--background-color-box);
         display: flex;
         flex-direction: row;
         h1 {
            font-weight: bold; 
         }
         h2 {
            font-size: 85%;
         }
         &.field-count-0 {
            display: grid;
            justify-content: center; 
         }
         &.field-count-1 {
            display: grid; 
            grid-template-columns: 1fr 3rem;
         }
         &.field-count-2 {
            display: grid; 
            grid-template-columns: 1fr 3rem 3rem;
         }
         &.field-count-3 {
            display: grid; 
            grid-template-columns: 1fr 3rem 3rem 3rem;
         }  
         &.field-count-4 {
            display: grid; 
            grid-template-columns: 1fr 3rem 3rem 3rem 3rem;
         }        
      }
      &.headless { 
         .box-header {
            display: none; 
         }
      }
      .repcontainer {
         width: 100%;
         display: block;
         &.editmode + .repcontrol button.repcontrol_edit:before {
            content: 'playlist_add_check';
         }
         .collapse:not(checked) ~ .expanded {
            //backdrop-filter: brightness(100%);
            //animation-name: var(--anim-pulse);
            //animation-duration: 1.5s;
            //animation-iteration-count: infinite;
            //animation-direction: alternate-reverse;
            //animation-timing-function: ease;
         }
         @keyframes bgpulse {
            0% {
               background-color: transparent;
            }
            100% {
               background-color: rgb(0,0,0,0.2);
            }
            
         }
         @keyframes bgpulse-dark {
            0% {
               background-color: rgb(255,255,255,0.2);
            }
            100% {
               background-color: transparent;
            }
            
         }
      }
      .repcontrol {
         //position: absolute;
         //top: 0.25rem; 
         //right: 0.25rem;
         //overflow: clip;
         display: flex;
         width: 100%;
         justify-content: flex-end;
         button {
            max-width: 1.75rem;
            max-height: 1.75rem;
            font-size: 0;
            overflow: hidden;
            position: relative;
            color: transparent;
            &:before {
               //width: 1.25rem;
               //height: 1.25rem;
               position: relative;
               inset: 0;
               font-family: 'Material Symbols Outlined';
               font-size: 1.5rem;
               font-weight: normal;
               color: var(--font-color);
               //border: 1pc solid var(--font-color);
               //border-radius: 50%;
               height: 1.75rem;
               width: 1.75rem;
               margin-right: 0.25rem;
               display: grid;
               place-content: center;
            }
            &.repcontrol_edit:before {
               padding-top: 0.2rem;
               content: 'edit_note';
            }
            &.repcontrol_add:before {
               content: 'playlist_add';
            }

         }
      }
   }