mixin gear({name,attr,i18n,describe,move,enc}) 
   - 
      name = name == undefined ? 'Utrustning' : name; 
      attr = attr == undefined ? 'gear' : attr; 
   .section-gear(class='section-gear__'+attr)
      if attr == 'gear'
         +input({name:attr+'_encumbrance',type:'number',class:'hidden',trigger:{triggeredFuncs:['setAllEncumbrance']}})
      else 
         +input({name:attr+'_encumbrance',type:'number',class:'hidden'})
      - transl = i18n ? i18n : attr; 
      +box({headerObj:{name:name,attr:attr,'data-i18n':transl},fields:[{name:'antal',attr:'amount'},{name:'vikt',attr:'weight'}],classes:''})
         +fieldset({name:attr})
            .gear-row
               //-+collapse
               +describe
               //-.collapsed
                  .label-input.input-count-2.checkboxed
                     //- labelObj: {class: 'label-input-label',type:'roller',name: skill.name, attr: skill.attr },
                     +checkbox({name:'equipped',value:1,checked:true,title:'Utrustning buren på kroppen, annars förvarad annorstädes.','data-i18n-title':'equipped-gear-desc'})
                     label.select-input 
                        +span({name:'name'})
                     //- label.text-input
                        +text({name:'name',class:'text-input'})
                     +span({name:'amount',type:'number'}).input-span.input-0
                     +span({name:'weight',type:'number'}).input-span.input-last
               .expanded
                  .label-input.input-count-2.checkboxed 
                     //-label.text-input 
                        +text({name:'name'}).caps-input
                     +checkbox({name:'equipped',value:1,checked:true,trigger:{triggeredFuncs:['setAllEncumbrance']}})
                     label.text-input                     
                        +input({type: 'text', name: 'name', placeholder:'Namn',class:'label-input-text',trigger:{triggeredFuncs:['setAllEncumbrance']}})
                     span.input-span.input-0
                        +input({type: 'number', name: 'amount', value: 1, class:'label-input-input',trigger:{triggeredFuncs:['setAllEncumbrance']}})
                     span.input-span.input-last
                        +input({type: 'number', name: 'weight', value: 1, step: 'any', class:'label-input-input',trigger:{triggeredFuncs:['setAllEncumbrance']}})
                     if move != undefined
                        div.move-buttons
                           each m in move    
                              +action({name:'move '+m.toLowerCase(),class:'move-button move-to-'+m.toLowerCase(),trigger:{triggeredFuncs:['moveToGearlist']}})
                     +textarea({name:'description',placeholder:'Beskrivning...','data-i18n-placeholder':'description'})(class='description')
   .hidden-gear.for-upgrades.hidden 
      each id in [11,12,13,21,22,23,31,32,33,41,42,43,51,52,53,61,62,63,71,72,73]
         +text({name:'utrustning_'+id+'_text'})
         +number({name:'utrustning_'+id})
+scss.
   .section-gear {
      .box .box-header {
         height: 2.2rem; 
         h1 {
            display: flex;
            justify-content: center;
            &:after { 
               font-family: 'Material Symbols Outlined'; 
               margin-left: 0.25rem; 
               font-size: 110%;  
            }
         }
      }
      .box-gear .box-header h1:after { content: 'backpack' } 
      .box-storage .box-header h1:after { content: 'warehouse' } 
      .box-animal .box-header h1:after { content: 'chess_knight' } 
      .box-herbsndrugs .box-header h1:after { content: 'eco' } 
      .expanded {
         position: relative; 
         background-color: transparent;
         input {
            text-transform: capitalize;
         }
         &:hover .move-buttons {
            display: flex; 
         }
         .move-buttons {
            display: none;
            position: absolute;
            //width: 6rem;
            right: 6.5rem;
            //top: -0.375rem; 
            justify-content: flex-end;
            height: auto; 
            top: 0; 
            button {
               position: relative; 
               width: 1rem; 
               height: 1rem;                 
               &:before { 
                  position: absolute; 
                  inset: 0; 
                  top: -0.5rem; 
                  font-family: 'Material Symbols Outlined'; 
                  font-size: 100%;
                  height: 1.25rem;
                  align-self: self-start; 
               }
               &.move-to-storage:before { content: 'dresser'; }
               &.move-to-storage:before { content: 'home_storage'; }
               &.move-to-storage:before { content: 'warehouse'; }
               &.move-to-animal:before { content: 'chess_knight'; }
               &.move-to-gear:before { content: 'hiking'; }
               &.move-to-gear:before { content: 'backpack'; }
               &.move-to-herbsndrugs:before { content: 'eco'; }
               /*&:after {
                  position: absolute; 
                  inset: 0; 
                  font-family: 'Material Symbols Outlined';
                  content: 'swap_horiz';
               }*/
            }


         }
      }
   }
   