mixin toggle({name,value,checked,classes})
   - attr = name.toString().replaceAll(/-/g,"_").replaceAll(/ /g,"_");
   - name = name.toString().replaceAll(/ /g,"-").replaceAll(/_/g,"-");
   - value = !value && value != '0' ? 1 : value; 
   - checked = checked ? checked : true; 
   - classes = classes ? classes : '';
   +checkbox({name:attr,value:value,class:'hidden toggle-'+name+' '+name+' '+classes,hidden:true,checked:checked})