mixin repeatingSkills({name,attr,transl,fields,cost,impr,exp,b,altcosts,desc,headedit})
   - 
      i18n = transl ? transl : attr; 
      fields = fields ? fields : 
               (b ? [{name:'B',attr:'bskill_level'},{name:'FV',attr:'skill_level'},{name:'Mod.',attr:'modification_abbr'},{name:'Erf.',attr:'experience_abbr'}] :
               [{name:'FV',attr:'skill_level'},{name:'Mod.',attr:'modification_abbr'},{name:'Erf.',attr:'experience_abbr'}]);
      fields = exp === false && b === false ? [{name:'FV',attr:'skill_level'},{name:'Mod.',attr:'modification_abbr'}] : fields;
      skillTypeB = b != undefined && b ? 'bskills ' : '';
      bClass = b == undefined || b == true ? 'display-b' : 'hide-b';
      bFields =  b == undefined || b == true ? 'input-count-6' : 'input-count-5';  
      costDisplay = cost == undefined ? ' display-cost-select' : '';
      hideImprovementClass = impr == undefined || impr == true ? '' : 'hide-improvements '; 
      hideExperienceClass = exp != undefined && exp == false ? ' hide-experience' : ''; 
      altcosts = altcosts ? altcosts : false; 
      desc = desc ? desc : false; 
      headedit = headedit ? headedit : false; 
   +box({headerObj:{name:name,attr:attr,'data-i18n':i18n},fields:fields,headEdit:headedit,classes:'box-skills box-skills-'+attr+hideImprovementClass+skillTypeB+hideExperienceClass})
      +fieldset({name:attr})
         .skill-row.collapse-container(class=hideImprovementClass+skillTypeB+hideExperienceClass)
            if cost != undefined && cost > 0
               +number({name:'cost',value:cost,class:'hidden'})
            +number({name:'b',value:0,class:'hidden'})
            +checkbox({name:'type',value:'b',class:'type-b-selected hidden'})
            +collapse
            if desc 
               +describe
            .collapsed
               .label-input(class=bFields)
                  //- labelObj: {class: 'label-input-label',type:'roller',name: skill.name, attr: skill.attr },
                  label.select-input.collapsed 
                     +action({name:'roll',trigger:{triggeredFuncs:['rollRepeatingSkill']}})
                        +span({name:'name'})
                  //- label.text-input
                     +text({name:'name',class:'text-input'})
                  //-+span({name:'skill',type:'number'}).input-span.input-0 
                  if b || b == undefined
                     span.input-span.input-0 
                        +span({name:'b',type:'number',class:'label-input-input b-skill'}) 
                  span.input-span.input-1
                     +span({name: 'fv', class:'label-input-input'})
                  span.input-span.input-2
                     +input({name:'mod',type:'number'}).input-span.input-2
                  span.input-span.input-3.erf
                     +span({name:'erf'}).input-span.input-3
                  +checkbox({name:'improve',value:1,class:'improve-mark improve-mark-normal'})
                  +checkbox({name:'improve_perfect',value:1,class:'improve-mark improve-mark-perfect'})
                  if desc 
                     +span({name:'description',class:'description'})
            .expanded
               .label-input(class=bFields+costDisplay) 
                  //-label.text-input 
                     +text({name:'name'}).caps-input
                  label.select-input.expanded
                     +text({name:'name',id:'custom-skill-input'})                
                  if cost == undefined 
                     span.select-input.cost-select.input-1 
                        if altcosts 
                           +number({name:'cost'})
                        else 
                           +select({name:'cost'})
                              if attr == 'languages'
                                 +option({value:'1',title:'Primärfärdighet','data-i18n-title':'primary-skill'})
                                    | 1
                              +option({value:'3',title:'Yrkesfärdighet','data-i18n-title':'profession-skill'})
                                 | 3
                              +option({value:'5',selected:true,title:'Sekundärfärdighet','data-i18n-title':'secondary-skill'})
                                 | 5
                  if b 
                     span.input-span.input-0 
                        +span({name:'b',type:'number',class:'label-input-input b-skill'}) 
                  else if b == undefined
                     span.select-span.type-select.input-0
                        +select({name: 'type', class:'label-input-select', trigger: { triggeredFuncs: ['setSkillB']}})
                           +option({value:'a'})
                              | A 
                           +option({value:'b'})
                              | B  
                  if attr == 'weaponskills'
                     span.input-span.input-1
                        +input({type: 'number', name: 'fv', class:'label-input-input', trigger:{ triggeredFuncs:['setWeaponSkills']}})
                  else
                     span.input-span.input-1
                        +input({type: 'number', name: 'fv', class:'label-input-input', trigger: { triggeredFuncs: ['setSkillB']}})
                  span.input-span.input-2
                     +input({type: 'number', name: 'mod', class:'label-input-input'})
                  span.input-span.input-3.erf
                     +input({type: 'number', name: 'erf', class:'label-input-input'})
                  +checkbox({name:'improve',value:1,class:'improve-mark improve-mark-normal'})
                  +checkbox({name:'improve_perfect',value:1,class:'improve-mark improve-mark-perfect'})
                  if desc                     
                     +adaptiveTextarea({name:'description',placeholder:'Beskrivning...','data-i18n-placeholder':'description'})(class='description')