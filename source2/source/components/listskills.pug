mixin listSkills({namn,attr,transl,fields,array,cost})
   - 
      i18n = transl ? transl : attr; 
      fields = fields ? fields : [{name:'FV',attr:'skill_level'},{name:'Mod.',attr:'modification_abbr'},{name:'Erf.',attr:'experience_abbr'}];
      //array = Array.isArray(array) ? array : [];
   +box({headerObj:{name:namn,attr:attr,'data-i18n':i18n},fields:fields,classes:'box-skills box-skills-'+attr})
      //-each skill in rows
         - geAbbr = skill.base.slice(0,3).toUpperCase();
         +text({name: attr+'_name',value: skill.name,class:'hidden'})
         +label-inputs({
            label: name + geAbbr,
            divObj: {class:'column-'+attr},
            labelObj: {class: 'label-input-label',type:'roller',name: skill.name, attr: skill.attr,rollType:'skill'},
            inputObj: [
               {type: 'number', name: skill.attr+'_fv', class:'label-input-input input-'+skill.name},
               {type: 'number', name: skill.attr+'_mod', class:'label-input-input input-mod-'+skill.name},
               {type: 'number', name: skill.attr+'_erf', class:'label-input-input input-exp-'+skill.name},
               {type: 'checkbox', name: skill.attr+'_improve', value:1, nospan: true, class:'label-input-input improve-mark improve-mark-normal input-impr-'+skill.name},
               {type: 'checkbox', name: skill.attr+'_improve_perfect', value:1, nospan: true, class:'label-input-input improve-mark improve-mark-perfect input-impr-perf-'+skill.name},
            ]
            })
      each skill in array
         - geAbbr = skill.base ? ' ('+skill.base.slice(0,3).toUpperCase()+')' : "" ;
         - bskill = skill.bskill ? skill.bskill : false; 
         .skill-row 
            if cost
               +number({name:skill.attr+'_cost',value:cost,class:'hidden'})
            +text({name:skill.attr+'_name',value:skill.name,class:'hidden'})
            +number({name:skill.attr+'_b',value:0,class:'hidden'})
            +checkbox({name:skill.attr+'_type',value:'b',class:'type-b-selected hidden'})
            if bskill
               label.label-input.input-count-6
                  +action({name:skill.attr,trigger:{triggeredFuncs:['rollTrainedSkill']}})
                     span('data-18n'=skill.i18n+'-ge')= skill.name+geAbbr
                  span.input-span.input-0 
                     +span({name:skill.attr+'_b',type:'number',class:'label-input-input b-skill'})
                  span.input-span.input-1 
                     +input({name:skill.attr+'_fv', type:'number', class:'label-input-input',trigger:{triggeredFuncs:['updateTrainedSkill']}}).input-span.input-0
                  span.input-span.input-2 
                     +input({name:skill.attr+'_mod',type:'number',trigger:{triggeredFuncs:['updateTrainedSkill']}}).input-span.input-1
                  span.input-span.input-3 
                     +input({name: skill.attr+'_erf',type:'number'}).input-span.input-2
                  +checkbox({name:skill.attr+'_improve',value:1,class:'improve-mark improve-mark-normal'})
                  +checkbox({name:skill.attr+'_improve_perfect',value:1,class:'improve-mark improve-mark-perfect'})
            else 
               label.label-input.input-count-5
                  +action({name:skill.attr,trigger:{triggeredFuncs:['rollTrainedSkill']}})
                     span('data-18n'=skill.i18n+'-ge')= skill.name+geAbbr
                  span.input-span.input-0 
                     +input({name:skill.attr+'_fv', type:'number', class:'label-input-input',trigger:{triggeredFuncs:['updateTrainedSkill']}}).input-span.input-0
                  span.input-span.input-1 
                     +input({name:skill.attr+'_mod',type:'number',trigger:{triggeredFuncs:['updateTrainedSkill']}}).input-span.input-1
                  span.input-span.input-2 
                     +input({name: skill.attr+'_erf',type:'number'}).input-span.input-2
                  +checkbox({name:skill.attr+'_improve',value:1,class:'improve-mark improve-mark-normal'})
                  +checkbox({name:skill.attr+'_improve_perfect',value:1,class:'improve-mark improve-mark-perfect'})
//-+scss.
   .box-skill {
      .label-input {
         display: grid; 
         grid-template-columns: 1fr 3rem 3rem 3rem;
         button {
            span {
               border: 0; 
            }
         }
         
         button[type=action] {
            display: hidden;
         }
         
      &.input-count-5 {
         position: relative; 
         grid-template-columns: 1fr 3rem 3rem 3rem;
         input[type=checkbox].improve-mark {
            display: none;
            position: absolute;
            top: 0.2rem;
            right: 0;
            max-width: 0.2rem;
            max-height: 0.2rem;
            height: 0.2rem;
            width: 0.2rem;
            padding: 0;
            min-width: 0.6rem;
            min-height: 0.6rem;
            transform: rotate(45deg);
            &.improve-mark-perfect {
               top: 50%;
               //corner-shape: scoop;
               //border-radius: 50%;
               //width: 1rem;
               //min-width: 1rem;
               //min-height: 1rem;
               //transform: unset;
               //right: -0.2rem;
            }
            &:checked { 
               display: flex;
               background-color: var(--fill-color);
               &:before {
                  content: '';
               }
            }
         }
         &:hover input[type=checkbox] { display: flex; }
      }
         
         button[type=action] {
            display: hidden;
         }
      }

      input.exp-toggle {
         display: none; 
      }
      .repitem:hover {
         position: relative;
         input.exp-toggle {
           display: flex;
           position: absolute;
           left: -1rem;
           width: 1rem;
         } 
         border-bottom: 1px solid var(--border-color); 
      }
   }