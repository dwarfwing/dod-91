                     //-+checkbox({name:'improve_perfect',value:1,class:'improve-mark improve-mark-perfect'})
                  +input({name: 'yrkes_'+skill+'_text', type: 'text', class:'label-input-input',trigger:{triggeredFuncs:['updateTrainedSkill']}}).input-span.input-0
                  +input({name: 'yrkes_'+skill+'_fv', type: 'number', class:'label-input-input',trigger:{triggeredFuncs:['updateTrainedSkill']}}).input-span.input-1
                  //-span.input-span.input-1
                  +input({name: 'yrkes_'+skill+'_mod', type: 'number', class:'label-input-input',trigger:{triggeredFuncs:['updateTrainedSkill']}}).input-span.input-2
                  //-span.input-span.input-2
                  +input({name: 'yrkes_'+skill+'_erf', type: 'number', class:'label-input-input'}).input-span.input-3
         //-   +box({headerObj:{name:'Yrkesfärdigheter',attr:'professionskills','data-i18n':'trained-skills'},fields:[{name:'FV',attr:'skill_level'},{name:'Mod.',attr:'modification_abbr'},{name:'Exp.',attr:'experience_abbr'}],classes:'coverall'})
               each skill in spine.secondaryskills 
                  +input({name: skill.attr, type:'number', value: 0}).hidden
                  +input({name: skill.attr+'_mod', type:'number', value: 0}).hidden
                  +input({name: skill.attr+'_improve', type:'checkbox', value: 1,trigger:{triggeredFuncs:['setTrainedImprove']}}).hidden
                  +input({name: skill.attr+'_improve_perfect', type:'checkbox', value: 1,trigger:{triggeredFuncs:['setTrainedImprove']}}).hidden
               +fieldset({name:'professionskills',class:'collapse-container'})
                  +collapse
                  .collapsed
                     .label-input.input-count-3
                        //- labelObj: {class: 'label-input-label',type:'roller',name: skill.name, attr: skill.attr },
                        label.select-input 
                           +action({name:'roll',trigger:{triggeredFuncs:['rollTrainedSkill']}})
                              +span({name:'skill_name'})
                        //- label.text-input
                           +text({name:'name',class:'text-input'})
                        //-+span({name:'skill',type:'number'}).input-span.input-0
                        //-span.input-span.input-0
                           +checkbox({name:'improve',value:1,class:'improve-mark improve-mark-normal'})
                           //-+checkbox({name:'improve_perfect',value:1,class:'improve-mark improve-mark-perfect'})
                        +input({type: 'number', name: 'skill', class:'label-input-input',trigger:{triggeredFuncs:['updateTrainedSkill']}}).input-span.input-0
                        +input({name:'skill_mod',type:'number',trigger:{triggeredFuncs:['updateTrainedSkill']}}).input-span.input-1
                        +input({name:'skill_exp',type:'number'}).input-span.input-2
                  .expanded
                     .label-input.input-count-3 
                        //-label.text-input 
                           +text({name:'name'}).caps-input
                        label.select-input
                           +select({name:'name',trigger:{triggeredFuncs:['setSkill']}})                        
                              +option({'data-i18n':'select-choice',selected:'selected',disabled:'disabled',hidden:'hidden'}) 
                                 | --- Välj ---
                              each skill in spine.secondaryskills
                                 +option({value: skill.attr, 'data-i18n': skill.attr.replace(/_/,'-')})
                              +option({value:'custom-skill','data-i18n':'custom-skill'})
                                 | Lägg till manuellt
                           +input({name:'custom name display',type:'checkbox',value:1,class:'hidden toggle-custom-skill'})
                           +text({name:'custom name',id:'custom-skill-input',trigger:{triggeredFuncs:['setSkill']}})
                        //-span.input-span.input-0
                           //-+checkbox({name:'improve',value:1,class:'improve-mark improve-mark-normal'})
                           //-+checkbox({name:'improve_perfect',value:1,class:'improve-mark improve-mark-perfect'})
                        +input({type: 'number', name: 'skill', class:'label-input-input',trigger:{triggeredFuncs:['updateTrainedSkill']}}).input-span.input-0
                        //-span.input-span.input-1
                        +input({type: 'number', name: 'skill_mod', class:'label-input-input',trigger:{triggeredFuncs:['updateTrainedSkill']}}).input-span.input-1
                        //-span.input-span.input-2
                        +input({type: 'number', name: 'skill_exp', class:'label-input-input'}).input-span.input-2
+scss.
   .section-professionskills, .section-secondaryskills {
      border-bottom: 1px solid var(--border-color);
      :is(.expanded,.collapsed) {
         & > .label-input {
            //grid-template-columns: 1fr 3rem 3rem;
            grid-template-columns: 1fr 3rem 3rem 3rem;
         }
         button span {
            padding-left: 0.25rem;
         }
      } 
      .collapse {
         z-index: 1000; 
         top: -0.25rem; 
         right: 9rem; 
      }
      .skill-row {
         border-bottom: 1px solid var(--border-color);
         min-width: 100%;
         //height: 2.1rem; 
         line-height: var(--line-height);
         & > :is(.expanded,.collapsed) {
            height: var(--line-height);
            min-width: 100%; 
            border-bottom: 0; 
         }
         label, button {
            border-right: 0;
         }
         input[type=number] {
            border-left: 1px solid var(--border-color);
         }
         button[type=action] {
            min-width: 100%;
            border-right: 0;
            span {
               min-width: 100%; 
               border-right: 0; 
            }
         }
      }
      .collapse {
      }
      .expanded {           
         option {
            text-align: left;
            width: 100%;
         }
         select {
            width: 100%;
            height: unset;
            &:open {
               max-height: 6rem;
            }
            & + input[type="checkbox"] + input[type="text"] { 
               display: none;
               height: auto;
               width: 100%; 
               border-bottom: 1px dashed black;
               margin-bottom: 2px;
            }
            & + input[type="checkbox"]:checked + input[type="text"] { display: block; }
         }
      }
      span.input-span.input-0 {
         position: relative; 
         input[type=checkbox] {
            display: none;
            position: absolute;
            top: 0.2rem;
            right: 0;
            max-width: 0.2rem;
            max-height: 0.2rem;
            height: 0.2rem;
            width: 0.2rem;
            padding: 0;
            min-width: 0.6rem;
            min-height: 0.6rem;
            transform: rotate(45deg);
            &.improve-mark-perfect {
               top: 50%;
               //corner-shape: scoop;
               //border-radius: 50%;
               //width: 1rem;
               //min-width: 1rem;
               //min-height: 1rem;
               //transform: unset;
               //right: -0.2rem;
            }
            &:checked { 
               display: flex;
               background-color: var(--fill-color);
               &:before {
                  content: '';
               }
            }
         }
         &:hover input[type=checkbox] { display: flex; }
      }
   }
