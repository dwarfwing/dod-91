mixin weaponskills 
   .section-skills__weapon.section-weaponskills
      +repeatingSkills({name:'Vapenfärdigheter',attr:'weaponskills',transl:'weapon-skill'}) 
      //-+box({headerObj:{name:'vapenfärdigheter',attr:'weaponskills','data-i18n':'weapon-skills'},fields:[{name:'FV',attr:'skill_level'},{name:'Mod.',attr:'modification_abbr'},{name:'Erf.',attr:'experience_abbr'}]})
         +fieldset({name:'weaponskills'})
            +collapse
            //-+checkbox({name:'exp_normal',class:'exp-toggle exp-toggle-normal'})
            //-+checkbox({name:'exp_perfect',class:'exp-toggle exp-toggle-perfect'})
            .collapsed
               .label-input.input-count-3
                  //- labelObj: {class: 'label-input-label',type:'roller',name: skill.name, attr: skill.attr },
                  label.select-input.collapsed 
                     +action({name:'roll',trigger:{triggeredFuncs:['rollRepeatingSkill']}})
                        +span({name:'name'})
                  //- label.text-input
                     +text({name:'name',class:'text-input'})
                  //-+span({name:'skill',type:'number'}).input-span.input-0                  
                  span.input-span.input-0
                     +input({type: 'number', name: 'fv', class:'label-input-input'})
                     //- +checkbox({name:'improve',value:1,class:'improve-mark improve-mark-normal'})
                     //- +checkbox({name:'improve_perfect',value:1,class:'improve-mark improve-mark-perfect'})
                  +input({name:'mod',type:'number'}).input-span.input-1
                  +input({name:'erf',type:'number'}).input-span.input-2
            .expanded
               .label-input.input-count-3 
                  //-label.text-input 
                     +text({name:'name'}).caps-input
                  label.select-input.expanded
                     +text({name:'name',id:'custom-skill-input'})
                  span.input-span.input-0
                     +input({type: 'number', name: 'fv', class:'label-input-input'})
                  span.input-span.input-1
                     +input({type: 'number', name: 'mod', class:'label-input-input'})
                  span.input-span.input-2
                     +input({type: 'number', name: 'erf', class:'label-input-input'})
      +repeatingSkills({name:'Stridsfärdigheter',attr:'combatskills',transl:'combat-skill'}) 
      //-+box({headerObj:{name:'Stridsfärdigheter',attr:'combatskills','data-i18n':'combat-skills'},fields:[{name:'FV',attr:'skill_level'},{name:'Mod.',attr:'modification_abbr'},{name:'Erf.',attr:'experience_abbr'}]})
         +fieldset({name:'combatskills'})
            +collapse
            //-+checkbox({name:'exp_normal',class:'exp-toggle exp-toggle-normal'})
            //-+checkbox({name:'exp_perfect',class:'exp-toggle exp-toggle-perfect'})
            .collapsed
               .label-input.input-count-3
                  //- labelObj: {class: 'label-input-label',type:'roller',name: skill.name, attr: skill.attr },
                  label.select-input.collapsed 
                     +action({name:'roll',trigger:{triggeredFuncs:['rollRepeatingSkill']}})
                        +span({name:'name'})
                  //- label.text-input
                     +text({name:'name',class:'text-input'})
                  //-+span({name:'skill',type:'number'}).input-span.input-0                  
                  span.input-span.input-0
                     +input({type: 'number', name: 'fv', class:'label-input-input'})
                     //- +checkbox({name:'improve',value:1,class:'improve-mark improve-mark-normal'})
                     //- +checkbox({name:'improve_perfect',value:1,class:'improve-mark improve-mark-perfect'})
                  +input({name:'mod',type:'number'}).input-span.input-1
                  +input({name:'erf',type:'number'}).input-span.input-2
            .expanded
               .label-input.input-count-3 
                  //-label.text-input 
                     +text({name:'name'}).caps-input
                  label.select-input.expanded
                     +text({name:'name',id:'custom-skill-input'})
                  span.input-span.input-0
                     +input({type: 'number', name: 'fv', class:'label-input-input'})
                  span.input-span.input-1
                     +input({type: 'number', name: 'mod', class:'label-input-input'})
                  span.input-span.input-2
                     +input({type: 'number', name: 'erf', class:'label-input-input'})
      +listSkills({namn:'vapengrupper',attr:'weapontypes',transl:'weapon-types',array:spine.weaponskills})
      //-+box({headerObj:{name:'vapengrupper',attr:'weapontypes','data-i18n':'weapon-types'},fields:[{name:'FV',attr:'skill_level'},{name:'Mod.',attr:'modification_abbr'},{name:'Erf.',attr:'experience_abbr'}]})
         each skill in spine.weaponskills
            - geAbbr = skill.base.slice(0,3).toUpperCase();
            - name =  skill.name + ' (' + geAbbr + ')';
            +label-inputs({
               label: name,
               divObj: {class:'column-'+skill.name},
               labelObj: {class: 'label-input-label',type:'roller',name: skill.name,attr:skill.attr,rollType:'skill'},
               inputObj: [
                  {name: skill.attr+'_fv', type:'number', class:'label-input-input input-'+skill.attr},
                  {name: skill.attr+'_mod', type:'number', class:'label-input-input input-mod-'+skill.attr},
                  {name: skill.attr+'_erf', type:'number', class:'label-input-input input-exp-'+skill.attr}
               ]
            })
//-+scss.
   .section-weaponskills { 
      .box {
         //border-top: 5px solid var(--border-color);
         //border-right: 6px solid var(--border-color);
         //border-bottom: 6px solid var(--border-color);
         //border-left: 1px solid var(--border-color);
      }     
      .label-input {
         grid-template-columns: 1fr 3rem 3rem 3rem;
         button {
            min-width: calc(100% - 9rem);
            span {
               border: 0; 
               overflow: hidden;
            }
         }
         
         button[type=action] {
            display: hidden;
         }
      }
      input.exp-toggle {
         display: none; 
      }
      .repitem:hover {
         position: relative;
         input.exp-toggle {
           display: flex;
           position: absolute;
           left: -1rem;
           width: 1rem;
         } 
         //border-bottom: 1px solid var(--border-color); 
      }
   }