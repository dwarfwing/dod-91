mixin weaponskills 
   .section-skills__weapon.section-weaponskills
      +repeatingSkills({name:'Vapenfärdigheter',attr:'weaponskills',transl:'weapon-skill',b:false,listTrigger:['weaponSkillSelect']}) 

      +repeatingSkills({name:'Stridsfärdigheter',attr:'combatskills',transl:'combat-skill'}) 

      +repeatingSkills({name:'Vapentekniker',attr:'weapontechniques',transl:'weapon-techniques',altcosts:true,b:false,desc:true}) 
      //- rebuild so that it includes descriptions of the techniques

      +martialarts

      +listSkills({namn:'vapengrupper',attr:'weapontypes',transl:'weapon-types',array:spine.weaponskills,b:false})

//-+scss.
   .section-weaponskills { 
      .box {
         //border-top: 5px solid var(--border-color);
         //border-right: 6px solid var(--border-color);
         //border-bottom: 6px solid var(--border-color);
         //border-left: 1px solid var(--border-color);
      }     
      .label-input {
         grid-template-columns: 1fr 3rem 3rem 3rem;
         button {
            min-width: calc(100% - 9rem);
            span {
               border: 0; 
               overflow: hidden;
            }
         }
         
         button[type=action] {
            display: hidden;
         }
      }
      input.exp-toggle {
         display: none; 
      }
      .repitem:hover {
         position: relative;
         input.exp-toggle {
           display: flex;
           position: absolute;
           left: -1rem;
           width: 1rem;
         } 
         //border-bottom: 1px solid var(--border-color); 
      }
   }