+scss.
   .section-shield {
      .box-header  {
         display: grid;
         grid-template-columns: 1fr 3rem 3rem 3rem 6rem 3rem;
      }
      .collapsed,
      .expanded {
         display: grid;
         grid-template-columns: 2rem 1fr 3rem 3rem 3rem 6rem 3rem;
      }
      .collapsed {
         label.input-label {
            overflow-x: hidden;
         }
      }
      .expanded {
         label.text-input {
            overflow-x: hidden;
         }
      }
      label:is(.input-label,.text-input) { border: 0; width: 100%;  }
      span.input-span {
         display: flex;
         justify-content: space-evenly;
         border-left: 1px solid var(--border-color);
      }
      .label-input.input-count-3 {
         span {
            border-right: 0;
            &.colon {
               font-size: 85%;
               text-align: right; 
               &:after {
                  content: ':';
               }
            }
         }
         input:not(:checked):before {
            content: ' ';
         }
      }
      .repitem {
         border-bottom: 1px solid var(--border-color);
      }
   }
+module.   
   on('change:repeating_shield remove:repeating_shield', (e) => {
      //repeatingSum("shield_encumbrance","shield",["weight","equipped"]);
      var encumb = 0,
          slimit = 0; 
      getSectionIDs('shield', (sectionIDs) => {
         ////k.log(`Sections: ${JSON.stringify(sectionIDs)}`);
         sectionIDs.forEach( (section) => {
            getAttrs([
               `repeating_shield_${section}_weight`,
               `repeating_shield_${section}_equipped`, 
               `repeating_shield_${section}_limit`], 
               (values) => {
                  const wght =  values[`repeating_shield_${section}_weight`],
                        equip =  values[`repeating_shield_${section}_equipped`],
                        lim =  values[`repeating_shield_${section}_limit`];
                  //k.log(`Values: ${JSON.stringify(values)}`)
                  ////k.log('Equipped? '+(values[`repeating_shield_${section}_equipped`] == '0'))
                  encumb += equip == '0' ? parseFloat(wght) : 0;
                  slimit += equip != '0' ? parseInt(lim) : 0;
                  //k.log(`shield encumbrance is ${encumb}, shield limiting is ${slimit}`);
                  ////k.log(`shield encumbrance is ${encumb}`);
                  setAttrs({ 
                     shield_encumbrance: encumb,
                     shield_limit: slimit
                  });               
            })
         });
         //attributes['shield_encumbrance'] = encumb; 
         //attributes.set();
      });
      //setAttrs({ shield_encumbrance: encumb });
   });

   
