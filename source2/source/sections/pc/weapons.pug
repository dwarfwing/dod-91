mixin weapons 
   .section-weapons
      +input({name:'weapon_encumbrance',type:'number',value:0,class:'hidden',trigger:{affects:['encumbrance']}})
      //-   let fields = spine.weaponskills; 
      +box({headerObj:{attr:'weapons','data-i18n':'weapons'},fields:spine.weaponfields,classes:'coverall'})
         +customControlFieldset({name:'weapons',addClass:'collapse-container',
            trigger: {addFuncs:['setSkill','weaponSkillSelect']}
            })
            +collapse
            +text({name:'skill_name',class:'hidden',value:'-- Välj --'})
            +checkbox({name:'skill_manual_toggle',value:1,class:'hidden skill-manual-toggle'})
            .collapsed
               .label-input 
                  each field in spine.weaponfields    
                     if field.type == 'checkbox'
                        if field.trigger 
                           +checkbox({name:field.attr,value:1,class:field.class,checked:true,trigger:{triggeredFuncs:[field.trigger]}})
                        else 
                           +checkbox({name:field.attr,value:1,class:field.class,checked:true})
                     else if field.type == 'select' && field.attr == 'skill'
                        +span({name:'skill_name'})
                     else if field.roller
                        +action({name:field.rollaction,class:field.class,trigger:{triggeredFuncs:[field.trigger]}})
                              +span({name:field.attr})
                     else 
                        +span({name:field.attr,class:field.class})
            .expanded
               .label-input.input-count-16
                  each field in spine.weaponfields    
                     if field.type == 'checkbox'
                        if field.trigger 
                           +checkbox({name:field.attr,value:1,class:field.class,checked:true,trigger:{triggeredFuncs:[field.trigger]}})
                        else 
                           +checkbox({name:field.attr,value:1,class:field.class,checked:true})
                     else if field.type == 'select' && field.attr == 'skill'
                        +select({name:'skill',trigger:{triggeredFuncs:['setWeaponSkills']}}).weapon-skill-select
                           +option({'data-i18n':'select-choice',selected:'selected',disabled:'disabled',hidden:'hidden'}) 
                              | --- Välj ---
                     else 
                        if field.trigger
                           +input({name:field.attr,type:field.type,trigger:{triggeredFuncs:[field.trigger]}})
                        else 
                           +input({name:field.attr,type:field.type})

   .hidden-weapons.for-upgrades.hidden 
      each weapon in [1,2,3,4,5,6,7]
         +text({name:'vapen_'+weapon+'_text'})
         +number({name:'vapen_'+weapon+'_fv'})
         +number({name:'vapen_'+weapon+'_erf'})
         +number({name:'vapen_'+weapon+'_bv'})
         +text({name:'vapen_'+weapon+'_skada'})
         +text({name:'vapen_'+weapon+'_rakvd'})
         +number({name:'vapen_'+weapon+'_langd'})
         +number({name:'vapen_'+weapon+'_vikt'})
+scss.
   .section-weapons {
      width: 100%;
      grid-column: 1 / -1;
      //border-inline: 4px solid var(--border-color);
      .box-header {
         h2:nth-of-type(2) {
            font-weight: bold; 
            font-size: 100%;
         }
      }
      .box-header, .repitem .collapsed div, .repitem .expanded div {
         display: grid; 
         grid-template-columns: 2rem calc(22% - 1rem) 10% 4% 4% 4% 3% 7% 7% 4% 6% 5% 4% 6% 4% 5% 4%;
         & * {
            border: 0;
            width: 100%;
            border-radius: 0; 
         }
         & > * {
            border-right: 1px solid var(--border-color);
         }
         & > h2:first-of-type { border-right: 0; overflow: visible; }
         & > h1 { border-right: 0; }
         & > h2:last-of-type, & > span:last-of-type {
            border: 0;
         }
      }
      .repcontrol-button.repcontrol-button--add {
         position: absolute;
         //border: 1px solid pink;
         width: 1rem;
         bottom: 0.35rem;
         right: 0.5rem;
         padding: 0;
         &:before {
            inset: 0;
            font-family: "Material Symbols Outlined";
            content: 'playlist_add';
            font-size: 1.5rem;
            font-weight: normal;
            color: var(--font-color);
            height: 1.75rem;
            width: 1.75rem;
         }
      }
      .repcontrol {
         width: calc(100% - 1.5rem);
         button.repcontrol_edit {

         }
      }
      .repitem {
         .itemcontrol {
            z-index: 10000;
            a.repcontrol_move {
               height: 2rem;
               width: 2rem;
               margin-top: -0.5rem;
               padding: 0;
               align-content: center;
            } 
         }
         .label-input {
            height: 2.125rem;
         }
         .collapse {
            left: 2rem; 
            //top: -0.375rem; 
            z-index: 10000; 
            & ~ .expanded {
               background-color: var(--bg-color3);
               .label-input { background-color: var(--bg-color3); }
            }
         }
         input[type="text"]:not(.caps-input), span {
            text-align: center;
         }
         button {
            display: flex;
            justify-content: center;
            gap: 0; 
            span {
               text-align: center; 
            }
            &.init-button span {
               width: 1.25rem;
            }
         }
         input[type=checkbox]:not(.collapse,.describe) { 
            height: 100%; 
            &:first-of-type {
               border-right: 0; 
            }
         }
         input[type=checkbox].weapon-equipped:not(:checked) ~ button,
         input[type=checkbox].weapon-equipped:not(:checked) ~ span button {
            pointer-events: none; 
            &:before {
               content: '';
               width: 1.675rem;
            }
         }
         .collapsed input[type=checkbox]:not(:first-of-type) { 
             pointer-events: none; 
         }
         input.manual-skillname-toggle + span + input,
         input.manual-skillname-toggle:checked + span {
            display: none; 
         }
         input.manual-skillname-toggle:checked + span + input {
            display: flex; 
            box-sizing: border-box;
            font-size: 100%;
            width: calc(100% + 1px);
         }
         span[name='attr_name'], 
         span[name='attr_range'],
         select[name='attr_skill'],
         select[name='attr_skill'] option,
         input[name='attr_range'] {
            overflow-x: hidden;
            text-indent: 0.25rem;
            white-space: nowrap;
            appearance: auto; 
            align-items: center; 

         }
         span[name=attr_damage].text-span {
            width: auto; 
         }
         span.currMax {
            display: flex; 
            flex-direction: row;
            justify-content: space-around;
         }
         span.slash {
            width: 1rem;
         }
         .smaller-text {
            font-size: 90%;
         }
      }
   }              
+module.
   const weaponEncumbrance = function() {
      repeatingSum("weapon_encumbrance","weapons",["weight","equipped"]);
   }
   k.registerFuncs({weaponEncumbrance});

   const initializeWeapons = function() {
      const weapons = k.getSections(
         {section:'repeating_weapons',fields:['name']},
         (attributes,sections) => {
            k.log(`Section weapons attributes: ${attributes}`);
            k.log(`Section weapons section: ${sections}`);
         }
      );
   }
   k.registerFuncs({initializeWeapons},{type:['opener']});



