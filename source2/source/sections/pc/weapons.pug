+scss.
   .section-weapons {
      width: 100%;
      grid-column: 1 / -1;
      //border-inline: 4px solid var(--border-color);
      .box-header, .repitem .collapsed div, .repitem .expanded div {
         display: grid; 
         grid-template-columns: 2rem calc(22% - 1rem) 10% 4% 4% 4% 3% 6% 6% 4% 6% 6% 4% 7% 4% 5% 4%;
         & * {
            border: 0;
            width: 100%;
            border-radius: 0; 
         }
         & > * {
            border-right: 1px solid var(--border-color);
         }
         & > h2:first-of-type { border-right: 0; overflow: visible; }
         & > h1 { border-right: 0; }
         & > h2:last-of-type, & > span:last-of-type {
            border: 0;
         }
      }
      .repitem {
         .itemcontrol {
            z-index: 10000;
            a.repcontrol_move {
               height: 2rem;
               width: 2rem;
               margin-top: -0.5rem;
               padding: 0;
               align-content: center;
            } 
         }
         .collapse {
            left: 2rem; 
            top: -0.375rem; 
            z-index: 10000; 
            & ~ .expanded {
               background-color: var(--bg-color3);
               .label-input { background-color: var(--bg-color3); }
            }
         }
         input[type="text"]:not(.caps-input), span {
            text-align: center;
         }
         button {
            display: flex;
            justify-content: center;
            span {
               text-align: center; 
            }
            &.init-button span {
               width: 1.25rem;
            }
         }
         input[type=checkbox] { 
            height: 100%; 
            &:first-of-type {
               border-right: 0; 
            }
         }
         input[type=checkbox].weapon-equipped:not(:checked) ~ button,
         input[type=checkbox].weapon-equipped:not(:checked) ~ span button {
            pointer-events: none; 
            &:before {
               content: '';
               width: 1.675rem;
            }
         }
         .collapsed input[type=checkbox]:not(:first-of-type) { 
             pointer-events: none; 
         }
         input.manual-skillname-toggle + span + input,
         input.manual-skillname-toggle:checked + span {
            display: none; 
         }
         input.manual-skillname-toggle:checked + span + input {
            display: flex; 
            box-sizing: border-box;
            font-size: 100%;
            width: calc(100% + 1px);
         }
         span[name='attr_name'], 
         span[name='attr_range'],
         select[name='attr_skill'],
         select[name='attr_skill'] option,
         input[name='attr_range'] {
            overflow-x: hidden;
            text-indent: 0.25rem;
            white-space: nowrap;
            font0size: 85%; 
         }
         span[name=attr_damage].text-span {
            width: auto; 
         }
         span.currMax {
            display: flex; 
            flex-direction: row;
            justify-content: space-around;
         }
         span.slash {
            width: 1rem;
         }
         .smaller-text {
            font-size: 80%;
         }
         span.damage, span.damage-button {
            display: flex;
            flex-direction: row; 
            justify-content: space-around; 
            input[type=checkbox] {
               border: 1px solid var(--border-color);
               margin-inline: 0.125rem;
            }
            label.input-label {
               display: flex;
               flex-direction: column-reverse;
               align-content: center;
               height: auto;
               cursor: pointer; 
               input[type=checkbox] {
                  border: 1px solid var(--border-color);
                  margin-inline: 0.125rem;
                  display: none;
               }
               span {
                  font-family: 'Material Symbols Outlined';
                  text-align: center;
                  &:after {
                     font-family: 'Material Symbols Outlined';
                     font-size: 1.375rem;
                     text-align: center;
                     padding-top: 0.25rem;
                  }
               }
               &:first-of-type span:after { content: 'toggle_on'; transform: rotate(-45deg);} 
               &:nth-of-type(2) span:after { content: 'nest_secure_alarm'; }
               &:last-of-type span:after { content: 'stat_1'; }
                 
               &:first-of-type input:checked + span:after { content: 'carpenter'; }
               &:nth-of-type(2) input:checked + span:after { content: 'nest_heat_link_e'; }
               &:last-of-type input:checked + span:after { content: 'stat_3'; }
            }
         }
      }
   }              
+module.
   const weaponEncumbrance = function() {
      repeatingSum("weapon_encumbrance","weapons",["weight","equipped"]);
   }
   k.registerFuncs({weaponEncumbrance});

   const initializeWeapons = function() {
      const weapons = k.getSections(
         {section:'repeating_weapons',fields:['name']},
         (attributes,sections) => {
            k.log(`Section weapons attributes: ${attributes}`);
            k.log(`Section weapons section: ${sections}`);
         }
      );
   }
   k.registerFuncs({initializeWeapons},{type:['opener']});



