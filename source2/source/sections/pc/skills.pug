mixin skills 
   .section-skill 
      +box({headerObj:{name:'primära färdigheter',attr:'skills','data-i18n':'basic-skills'},fields:[{name:'FV',attr:'skill_level'},{name:'Mod.',attr:'modification_abbr'},{name:'Erf.',attr:'experience_abbr'}]})
         each skill in spine.primaryskills
            - geAbbr = skill.base.slice(0,3).toUpperCase();
            +text({name: skill.attr+'_name',value: skill.name,class:'hidden'})
            +label-inputs({
               label: skill.name + ' (' + geAbbr + ')',
               divObj: {class:'column-'+skill.name},
               labelObj: {class: 'label-input-label',type:'roller',name: skill.name, attr: skill.attr,rollType:'skill'},
               inputObj: [
                  {type: 'number', name: skill.attr+'_fv', class:'label-input-input input-'+skill.name},
                  {type: 'number', name: skill.attr+'_mod', class:'label-input-input input-mod-'+skill.name},
                  {type: 'number', name: skill.attr+'_erf', class:'label-input-input input-exp-'+skill.name}
               ]
               })
            //- i18n = skill.attr.replace(/_/,'-');
            //-div(class=`label-input input-count-3 column-${skill.attr}`)
               +roller({name:skill.name,'data-i18n':skill.name, trigger:{triggeredFuncs:[`rollSkill`]}})
               span.input-span.input-0
                  //-+checkbox({name:skill.attr+'_improve',value:1,class:'improve-mark improve-mark-normal'})
                  //-+checkbox({name:skill.attr+'_improve_perfect',value:1,class:'improve-mark improve-mark-perfect'})
                  +number({name:skill.attr,class:`.label-input-input.input-${skill.name}`})
               span.input-span.input-1
                  +number({name:skill.attr+'_mod',class:`.label-input-input.input-mod-${skill.name}`})
               span.input-span.input-2
                  +number({name:skill.attr+'_exp',class:`.label-input-input.input-exp-${skill.name}`})
         +fieldset({name:'primaryskills'})
            +collapse
            //-+checkbox({name:'exp_normal',class:'exp-toggle exp-toggle-normal'})
            //-+checkbox({name:'exp_perfect',class:'exp-toggle exp-toggle-perfect'})
            .collapsed
               .label-input.input-count-3
                  //- labelObj: {class: 'label-input-label',type:'roller',name: skill.name, attr: skill.attr },
                  label.select-input.collapsed 
                     +action({name:'roll',trigger:{triggeredFuncs:['rollNaturalSkill']}})
                        +span({name:'skill_name'})
                  //- label.text-input
                     +text({name:'name',class:'text-input'})
                  //-+span({name:'skill',type:'number'}).input-span.input-0                  
                  span.input-span.input-0
                     +input({type: 'number', name: 'skill_fv', class:'label-input-input'})
                     //- +checkbox({name:'improve',value:1,class:'improve-mark improve-mark-normal'})
                     //- +checkbox({name:'improve_perfect',value:1,class:'improve-mark improve-mark-perfect'})
                  +input({name:'skill_mod',type:'number'}).input-span.input-1
                  +input({name:'skill_erf',type:'number'}).input-span.input-2
            .expanded
               .label-input.input-count-3 
                  //-label.text-input 
                     +text({name:'name'}).caps-input
                  label.select-input.expanded
                     +text({name:'skill_name',id:'custom-skill-input'})
                  span.input-span.input-0
                     +input({type: 'number', name: 'skill_fv', class:'label-input-input'})
                  span.input-span.input-1
                     +input({type: 'number', name: 'skill_mod', class:'label-input-input'})
                  span.input-span.input-2
                     +input({type: 'number', name: 'skill_erf', class:'label-input-input'})
+scss.
   .section-skill {
      .label-input {
         grid-template-columns: 1fr 3rem 3rem 3rem;
         button {
            span {
               border: 0; 
            }
         }
         
         button[type=action] {
            display: hidden;
         }
      }
      input.exp-toggle {
         display: none; 
      }
      .repitem:hover {
         position: relative;
         input.exp-toggle {
           display: flex;
           position: absolute;
           left: -1rem;
           width: 1rem;
         } 
         border-bottom: 1px solid var(--border-color); 
      }
   }