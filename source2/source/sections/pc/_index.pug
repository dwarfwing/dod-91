include ./info
include ./skills
include ./skill-list
include ./professionskills
include ./languages
include ./secondaryskills
include ./customroll
include ./experience
include ./encumbrance
include ./weapons
include ./armor
include ./shield
include ./gear
include ./resonance
include ./abilities
include ./money
include ./notes

mixin pc-view
   +attributes
   +info
   +skills
   +professionskills
   +experience 
   +encumbrance
   +weapons
