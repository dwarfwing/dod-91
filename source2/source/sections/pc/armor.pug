mixin armor 
   .section-armor
      +input({name:'armor_encumbrance',type:'number',value:0,class:'hidden',trigger:{affects:['encumbrance']}}) 
      +input({name:'armor_limit',type:'number',value:0,class:'hidden'}) 
      +input({name:'helmet_limit',type:'number',value:0,class:'hidden'}) 
      +box({headerObj:{name:'rustning',attr:'armor','data-i18n':'armor'},fields:[{name:'ABS',attr:'absorption'},{name:'BEG',attr:'limit'},{name:'VIKT',attr:'weight'}],classes:'coverall'})
         +fieldset({name:'armor'})
            +collapse
            .collapsed
               .label-input.input-count-3.checkboxed
                  //- labelObj: {class: 'label-input-label',type:'roller',name: skill.name, attr: skill.attr },
                  +checkbox({name:'equipped',value:1,checked:true,title:'Rustningen klädd på kroppen','data-i18n-title':'equipped-armor-desc'})
                  label.input-label
                     +span({name:'name'})
                     //-+checkbox({name:'armor',value:'1',class:'armor-icon'})
                     //-+checkbox({name:'helmet',value:'1',class:'helmet-icon'})
                  //- label.text-input
                     +text({name:'name',class:'text-input'})
                  +span({name:'absorption',type:'number'}).input-span.input-0
                  +span({name:'limit',type:'number'}).input-span
                  +span({name:'weight',type:'number'}).input-span.input-last
            .expanded
               .label-input.input-count-3.checkboxed 
                  //-label.text-input 
                     +text({name:'name'}).caps-input
                  //-+checkbox({name:'equipped',value:1,checked:true,trigger:{triggeredFuncs:['armorEncumbrance']},title:'Rustningen klädd på kroppen','data-i18n-title':'equipped-armor-desc'})
                  span
                  label.text-input                     
                     +input({type: 'text', name: 'name', class:'label-input-text'})
                  span.input-span.input-0
                     +input({type: 'number', name: 'absorption', class:'label-input-input'})
                  span.input-span
                     +input({type: 'number', name: 'limit', class:'label-input-input'})
                  span.input-span.input-last
                     +input({type: 'number', name: 'weight', class:'label-input-input'})
                  span 
                  +span({'data-i18n':'armor'}).colon Rustning
                  +checkbox({name:'armor',value:'1',class:'armor-indicator','data-i18n-title':'armor-indicator-desc'})
                  +span({'data-i18n':'helmet'}).colon Hjälm
                  +checkbox({name:'helmet',value:'1',class:'helmet-indicator','data-i18n-title':'helmet-indicator-desc'})

+scss.
   .section-armor {
      .label-input.input-count-3 {
         span {
            border-right: 0;
            &.colon {
               font-size: 85%;
               text-align: right; 
               &:after {
                  content: ':';
               }
            }
         }
         input:not(:checked):before {
            content: ' ';
         }
         label.input-label input {
            width: 0;
            min-width: 0;
            border: 0;
            pointer-events: none; 
            margin-right: 0.5rem;
            &:before {
               all: unset;
               content: '';
            }
            &:after {
               width: 0; 
            }
            &.armor-icon:checked:after { 
               content:'directions_walk';
               font-family: 'Material Symbols Outlined';
               width: 0.75rem;
             }
            &.helmet-icon:checked:after { 
               content:'face_6';
               font-family: 'Material Symbols Outlined';
               width: 0.75rem;
             }
         }
         input[class*="indicator"] {
            justify-self: center;
         }
      }
      .collapsed {
         label.input-label {
            overflow-x: hidden;
         }
      }
      .expanded {
         label.text-input {
            overflow-x: hidden;
         }
      }
   }
+module.   
   on('change:repeating_armor remove:repeating_armor', (e) => {
      //repeatingSum("armor_encumbrance","armor",["weight","equipped"]);
      var encumb = 0,
          alimit = 0,
          hlimit = 0; 
      getSectionIDs('armor', (sectionIDs) => {
         ////k.log(`Sections: ${JSON.stringify(sectionIDs)}`);
         sectionIDs.forEach( (section) => {
            getAttrs([
               `repeating_armor_${section}_weight`,
               `repeating_armor_${section}_equipped`, 
               `repeating_armor_${section}_limit`, 
               `repeating_armor_${section}_armor`, 
               `repeating_armor_${section}_helmet`], 
               (values) => {
                  const wght =  values[`repeating_armor_${section}_weight`],
                        equip =  values[`repeating_armor_${section}_equipped`],
                        lim =  values[`repeating_armor_${section}_limit`],
                        helm =  values[`repeating_armor_${section}_helmet`],
                        armr =  values[`repeating_armor_${section}_armor`];
                  //k.log(`Values: ${JSON.stringify(values)}`)
                  ////k.log('Equipped? '+(values[`repeating_armor_${section}_equipped`] == '0'))
                  encumb += equip == '0' ? parseInt(wght) : 0;
                  alimit += equip != '0' && armr == '1' ? parseInt(lim) : 0;
                  hlimit += equip != '0' && helm == '1' ? parseInt(lim) : 0;
                  //k.log(`Armor encumbrance is ${encumb}, armor limiting is ${alimit}, helmet limiting is ${hlimit}`);
                  ////k.log(`Armor encumbrance is ${encumb}`);
                  setAttrs({ 
                     armor_encumbrance: encumb,
                     armor_limit: alimit,
                     helmet_limit: hlimit 
                  });               
            })
         });
         //attributes['armor_encumbrance'] = encumb; 
         //attributes.set();
      });
      //setAttrs({ armor_encumbrance: encumb });
   });

   
