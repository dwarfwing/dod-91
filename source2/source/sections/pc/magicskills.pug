mixin magicskills 
   .section-skills__magic.section-magicskills
      //-+modalButton({name:'testmodal'})
         span.mateirals-icon settings
      //-+modalWindow({name:'testmodal'})
         p This is a test modal!
      +repeatingSkills({name:'magiskolor',attr:'magicschools',transl:'magic-schools',exp:false}) 
      //-+box({headerObj:{name:'magiskolor',attr:'magicschools','data-i18n':'magic-sschools'},fields:[{name:'FV',attr:'skill_level'},{name:'Mod.',attr:'modification_abbr'},{name:'Erf.',attr:'experience_abbr'}]})
         //-+customControlFieldset({name:'magicschools',trigger:{
            triggeredFuncs:['magicSchoolRemove'],
            addFuncs:['magicSchoolAdd']
            }})
         +fieldset({name:'magicschools'})
            +collapse
            //-+checkbox({name:'exp_normal',class:'exp-toggle exp-toggle-normal'})
            //-+checkbox({name:'exp_perfect',class:'exp-toggle exp-toggle-perfect'})
            .collapsed
               .label-input.input-count-3
                  //- labelObj: {class: 'label-input-label',type:'roller',name: skill.name, attr: skill.attr },
                  label.select-input.collapsed 
                     +action({name:'roll',trigger:{triggeredFuncs:['rollRepeatingSkill']}})
                        +span({name:'name'})
                  //- label.text-input
                     +text({name:'name',class:'text-input'})
                  //-+span({name:'skill',type:'number'}).input-span.input-0                  
                  span.input-span.input-0
                     +input({type: 'number', name: 'fv', class:'label-input-input'})
                     //- +checkbox({name:'improve',value:1,class:'improve-mark improve-mark-normal'})
                     //- +checkbox({name:'improve_perfect',value:1,class:'improve-mark improve-mark-perfect'})
                  +input({name:'mod',type:'number'}).input-span.input-1
                  +input({name:'erf',type:'number'}).input-span.input-2
            .expanded
               .label-input.input-count-3 
                  //-label.text-input 
                     +text({name:'name'}).caps-input
                  label.select-input.expanded
                     +text({name:'name',id:'custom-skill-input'})
                  span.input-span.input-0
                     +input({type: 'number', name: 'fv', class:'label-input-input'})
                  span.input-span.input-1
                     +input({type: 'number', name: 'mod', class:'label-input-input'})
                  span.input-span.input-2
                     +input({type: 'number', name: 'erf', class:'label-input-input'})
      +repeatingSkills({name:'magifärdigheter',attr:'magicskills',transl:'magic-skills'}) 
      //-+box({headerObj:{name:'magifärdigheter',attr:'magicskills','data-i18n':'magic-skills'},fields:[{name:'FV',attr:'skill_level'},{name:'Mod.',attr:'modification_abbr'},{name:'Erf.',attr:'experience_abbr'}]})
         +fieldset({name:'magicskills'})
            +collapse
            //-+checkbox({name:'exp_normal',class:'exp-toggle exp-toggle-normal'})
            //-+checkbox({name:'exp_perfect',class:'exp-toggle exp-toggle-perfect'})
            .collapsed
               .label-input.input-count-3
                  //- labelObj: {class: 'label-input-label',type:'roller',name: skill.name, attr: skill.attr },
                  label.select-input.collapsed 
                     +action({name:'roll',trigger:{triggeredFuncs:['rollRepeatingSkill']}})
                        +span({name:'name'})
                  //- label.text-input
                     +text({name:'name',class:'text-input'})
                  //-+span({name:'skill',type:'number'}).input-span.input-0                  
                  span.input-span.input-0
                     +input({type: 'number', name: 'fv', class:'label-input-input'})
                     //- +checkbox({name:'improve',value:1,class:'improve-mark improve-mark-normal'})
                     //- +checkbox({name:'improve_perfect',value:1,class:'improve-mark improve-mark-perfect'})
                  +input({name:'mod',type:'number'}).input-span.input-1
                  +input({name:'erf',type:'number'}).input-span.input-2
            .expanded
               .label-input.input-count-3 
                  //-label.text-input 
                     +text({name:'name'}).caps-input
                  label.select-input.expanded
                     +text({name:'name',id:'custom-skill-input'})
                  span.input-span.input-0
                     +input({type: 'number', name: 'fv', class:'label-input-input'})
                  span.input-span.input-1
