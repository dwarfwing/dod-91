                  span.input-span.input-2
                     +input({type: 'number', name: 'erf', class:'label-input-input'})
//-+scss.
   .section-magicskills { 
      .box {
         //border-top: 5px solid var(--border-color);
         //border-right: 6px solid var(--border-color);
         //border-bottom: 6px solid var(--border-color);
         //border-left: 1px solid var(--border-color);
      }     
      .label-input {
         grid-template-columns: 1fr 3rem 3rem 3rem;
         button {
            min-width: calc(100% - 9rem);
            span {
               border: 0; 
               overflow: hidden;
            }
         }
         
         button[type=action] {
            display: hidden;
         }
      }
      input.exp-toggle {
         display: none; 
      }
      .repitem:hover {
         position: relative;
         input.exp-toggle {
           display: flex;
           position: absolute;
           left: -1rem;
           width: 1rem;
         } 
         border-bottom: 1px solid var(--border-color); 
      }
      .repcontrol-button--add:before {
         font-family: inherit;
         content: '+Add'
      }
      .repcontainer .repitem .itemcontrol .repcontrol_del {
         transform: translateX(1.25rem);
      }
   }