mixin attributes 
   .section-attributes.collapse-container
      +collapse(name='attr_attributes_collapse') 
      +box({headerObj:{name:'grundegenskap',attr:'attributes','data-i18n':'attributes'},classes:'attributes-box'})
         each attribute in spine.attributes
            +input({type:'number',name:attribute.attr+'_encumb_mod',value:'',class:'hidden'})
            div(class='column-'+attribute.attr).label-input.input-count-2.attribute-row
               //-label(data-i18n=attribute.attr).label-input-label.label-input__text= attribute.name 
               +action({
                  name:'roll_'+attribute.attr,trigger:{triggeredFuncs:['rollAttribute']}
               })
                  label(data-i18n=attribute.attr).label-input-label.label-input__text= attribute.name 
               //-+action({name:'attr-'+attribute.attr,trigger:{triggeredFuncs:['rollAttribute']},'data-i18n-title':'attribute-roll'}).attribute-roll
               //-+action({name:'attr-contest-'+attribute.attr,trigger:{triggeredFuncs:['rollAttributeContest']},'data-i18n-title':'attribute-roll-contest'}).attribute-roll.ge-roll-geRollContest
               +input({type: 'number', name: attribute.attr+'_fv', min: 0, class:'expanded label-input-input input-'+attribute.attr+'',trigger:{triggeredFuncs:attribute.trigger,affects:attribute.affects}})
               +span({name: attribute.attr+'_fv', min: 0, class:'collapsed label-input-input label-input-span input-'+attribute.attr+''})
               span.input-span.input-span-mod(class='input-span-'+attribute.attr+'-mod')
                  +input({type: 'number', name: attribute.attr+'_mod', min: 0, class:'label-input-input input-'+attribute.attr+'-mod'})
                  +span({name:attribute.attr+'_encumb_mod',class:'label-input-modifier label-input-super input-encumb-mod-'+attribute.attr,title:'Överbelastad','data-i18n-title':'overencumbered'})
               +input({type: 'number', name: attribute.attr+'_bc', min: 0, class:'hidden label-input-input input-'+attribute.attr+'',hidden:true})
      +box({classes:'size-attributes headless'})
         div(class='column-length').label-input.input-count-1.attribute-row
            label(class="label-input__text", data-i18n="length", title="Karaktärens längd i cm", data-i18n-title="length-title") Längd
            span.input-span.label-input-span.input-0.expanded
               +text({name:"length", type:"text", title:"@{length}"})
            +span({name:'length',class:'collapsed label-input-span'})
         div(class='column-weight').label-input.input-count-1.attribute-row
            label(class="label-input__text", data-i18n="weight", title="Karaktärens vikt i kg", data-i18n-title="weight-title") Vikt
            span.input-span.label-input-span.input-0.expanded
               +text({name:"weight", type:"text", title:"@{weight}"})
            +span({name:'weight',class:'collapsed label-input-span'})
         //-+label-inputs({
            label: 'Längd',
            labelObj: { 'data-i18n': 'length'},
            divObj: { class: 'attribute-row'},
            spanObj: { },
            inputObj: [{ name:'length', type: 'text' }]
            })
         //-+label-inputs({
            label: 'Vikt',
            labelObj: { 'data-i18n': 'weight'},
            divObj: { class: 'attribute-row'},
            spanObj: { },
            inputObj: [{ name:'weight', type: 'text' }]
            })
+scss.
   .section-attributes {
      //display: inline-grid;
      //row-gap: 1rem;
      &:hover {
         .collapse {
            display: grid; 
         }
      }
      .box.attributes-box {
         //border-top: var(--border-size-2x) solid var(--border-color);
         //border-left: var(--border-size-2x) solid var(--border-color);
      }
      .size-attributes {
         .attribute-row {
            grid-template-columns: 1fr 5rem; 
            input {
               border-radius: 0;
               width: 100%;  
            }
         }
      }
      input.collapse {
         display: none;
         z-index: 1000;
         width: auto; 
         right: 0.25rem; 
         &:checked { 
            & ~ div .expanded {
               display: none;
            }
         }
         &:not(:checked) {
            display: grid; 
            opacity: unset;
            & ~ div .collapsed {
               display: none;
               input {               
                  background-color: var(--bg-color3);
               }               
            }
            & ~ div {
               input {               
                  background-color: var(--bg-color3);
               }             
            }
         }
      }
      button.roller {
         & + button {
            display: none;
         }
      } 
      .attribute-row {
         display: grid;
         grid-template-columns: 1fr 3rem 3rem;
         label {
            border: 0; 
            cursor: pointer; 
         }
         input {
            width: 100%;
            text-align: center; 
            border-left: 1px solid var(--border-color);

            background-color: var(--bg-color2);
         }
         span.input-span {
            position: relative; 
            .label-input-super {
               position: absolute; 
               right: 0; 
               top: 0; 
               height: 1rem; 
               font-size: 80%;
               z-index: 7000; 
               line-height: 0.75rem; 
               height: 0; 
            }
         }
         span.input-span-sty-mod {
            position: relative; 
            &:before {
               content: "Mod.";
               font-size: 75%;
               position: absolute;
               top: -1rem;
               left: 0;
               right: 0;
               width: 100%;
               height: 0.75rem;
               line-height: 0.75rem;
               text-align: center;
               z-index: 6000; 
            }
         }
         .label-input-span {
            border-left: 1px solid var(--border-color);
            width: 100%; 
            text-align: center; 
            background-color: var(--bg-color2);
            input {
               border: 0; 
            }
         }
         /*button[type=action].attribute-roll {
            display: none;
            width: 2rem;
            justify-self: center; 
            justify-content: center;
            margin-inline: 0.5rem; 
            cursor: pointer; 
            &:before {
               content: 't';
               font-size: 2.25rem;
            }
            &:last-of-type {
               &:before {
                  content: 'k'; 
               }
            }
         }*/
         /*&:hover {            
            grid-template-columns: 1fr 2.25rem 2.25rem 3rem;
            button[type=action].attribute-roll {
               display: flex; 
            }
         }*/
      }
   }


