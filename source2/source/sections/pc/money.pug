mixin money
   .section-money
      +box({headerObj:{name:'pengar',attr:'money','data-i18n':'money'},fields:[{name:'börs',attr:'carried'},{name:'juveler',attr:'juveler'},{name:'bank',attr:'bank'}]})
         //each attribute in ['akrobatics','bows','first aid','rifles','perception','throwing','bartering','melee','pistol','sneak/hide']
         each mynt in [{name:'Guldmynt',attr:'gm'},{name:'Silvermynt',attr:'sm'},{name:'Kopparmynt',attr:'km'},]
            - bors = 'pengar_bors_'+mynt.attr;
            - bank = 'pengar_bank_'+mynt.attr;
            - juvel = 'pengar_juveler_'+mynt.attr;
            if mynt.name == sm 
               juvel = 'juveler'
            +label-inputs({
               label: mynt.name,
               divObj: {class:'column-'+mynt.name},
               labelObj: {class: 'label-input-label',name: mynt.name, attr: mynt.attr},
               inputObj: [
                  {type: 'number', name: bors, class:'label-input-input input-'+mynt.name},
                  {type: 'number', name: juvel, class:'label-input-input input-'+mynt.name},
                  {type: 'number', name: bank, class:'label-input-input input-'+mynt.name}
               ]
            })
+scss.
   .section-money {
      .box-money .box-header.field-count-3, .input-count-3 {
         grid-template-columns: calc(100% - 13.5rem) 4.5rem 4.5rem 4.5rem;
         span {
            width: 100%; 
            input { padding: 0; text-align: center; }
         } 
      }
   }