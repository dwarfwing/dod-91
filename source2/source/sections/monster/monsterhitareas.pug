   .section-monster-hitareas {      
      &__header {
         margin-top: 1rem; 
         width: 100%;
         display: flex;
         align-content: center; 
         justify-content: center; 
         select {
            appearance: auto; 
         }
         display: flex; 
         justify-content: center; 
         button[type=roll] { width: auto; }
         button[type=action] { display: none; }
      }
      &__content {
         margin-top: 0.5rem;         
         span.hitarea-name {
            background-color: var(--border-color);
            color: var(--font-color-inverse);
            justify-self: center;
            width: 100%;
            justify-content: center;
            display: flex;
            align-items: center; 
            input {
               min-width: 5rem;
               border: 0; 
               text-transform: capitalize;
               field-sizing: content;  
            }
            &:before {
               content: attr(value);
            }
         }
         & > .box {
            display: none;
            justify-content: center; 
            align-self: flex-start;
            border: 2px solid var(--border-color);
            background-color: transparent;
            width: 45%;
            margin-top: 0.5rem; 
            & > * {
               width: 100%;
               input {
                  border: 1px solid var(--border-color);
                  &:first-of-type {
                     border-radius: 0;
                  }
               }
            }
            .box {
               background-color: transparent;
            }
            .box-header {
               background-color: var(--background-color-box);
               h1,h2,h3 {
                  color: var(--font-color);
               }               
            }
            & > h3 {
               height: 2rem;
               font-size: 0.675rem;
               display: flex;
               justify-content: center; 
               span,input {
                  text-align: center; 
                  border: 0;
               }
            }
            .repitem {
               margin-top: 0.25rem;
               padding-inline: 0.25rem;
            }
         }
      } 
      &__fixed-components {
         .box-header.field-count-1 {
            grid-template-columns: auto 2.5rem;
         } 
         .repitem {
            display: grid;
            grid-template-columns: auto 2rem;
            column-gap: 0.5rem;
            input[type=checkbox]:checked:before {
               content: '✗';
            }
         }
      }
      &__extra-plating {
         .repitem {
            display: grid;
            grid-template-columns: auto 3rem;
            column-gap: 0.5rem;
         }
      }     
   }