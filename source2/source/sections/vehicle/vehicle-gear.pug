mixin vehicle-gear   
   .section-vehicle-gear 
      +box({headerObj:{name:'utrustning',attr:'vehicle_gear','data-i18n':'gear'},fields:[{name:'antal',attr:'amount'},{name:'vikt',attr:'weight'},{name:'plats',attr:'location'}],classes:'coverall'})
         +fieldset({name:'vehiclegear'})
            //-+collapse
            //-.collapsed
               .label-input.input-count-2.checkboxed
                  //- labelObj: {class: 'label-input-label',type:'roller',name: skill.name, attr: skill.attr },
                  +checkbox({name:'equipped',value:1,checked:true,title:'Utrustning buren på kroppen, annars förvarad annorstädes.','data-i18n-title':'equipped-gear-desc'})
                  label.select-input 
                     +span({name:'name'})
                  //- label.text-input
                     +text({name:'name',class:'text-input'})
                  +span({name:'amount',type:'number'}).input-span.input-0
                  +span({name:'weight',type:'number'}).input-span.input-last
            //-.expanded
            .label-input.input-count-3 
               //-label.text-input 
                  +text({name:'name'}).caps-input
               //-+checkbox({name:'equipped',value:1,checked:true,trigger:{triggeredFuncs:['vehicleEncumbrance']}})
               label.text-input                     
                  +input({type: 'text', name: 'name', class:'label-input-text'})
               label.input-span.input-0
                  +input({type: 'number', name: 'amount', class:'label-input-input',trigger:{triggeredFuncs:['vehicleEncumbrance']}}).cut-corner
               label.input-span.input-last
                  +input({type: 'number', name: 'weight', class:'label-input-input',trigger:{triggeredFuncs:['vehicleEncumbrance']}}).cut-corner
               label.input-span.input-last
                  +input({type: 'number', name: 'location', class:'label-input-input'}).cut-corner
+scss. 
   .section-vehicle-gear {
      margin-top: 1rem; 
      .box {
         background-color: transparent; 
         .repitem {
            margin-top: 0.25rem;
            padding-inline: 0.25rem;
            .input-count-3 {
               grid-template-columns: auto 3.75rem 3.75rem 3.75rem;
            }
            label {
               border: 0;
            }
            label:first-of-type input {
               border-radius: 0; 
               width: 100%;
            }
         }
      }
   }