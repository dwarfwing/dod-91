mixin vehicle-header 
   .section-vehicle-info
      //-+box({headerObj:{}})
      +text({name:'character_name',placeholder:'Name','data-i18n':'name'}).section-vehicle-info__vehicle-name
      +box({headerObj:{},classes:'section-vehicle-info__vehicle-info topless bottomless'})
         +input-label({
            label:'Fordonstyp',
            inputObj:{name:'vehicle_type',type:'text'},
            spanObj:{'data-i18n':'vehicle-type'},
            divObj:{class:'input-label-text input-count-1'}}
            )
         +input-label({
            label:'Kampanj',
            inputObj:{name:'campaign',type:'text'},
            spanObj:{'data-i18n':'campaign'},
            divObj:{class:'input-label-text input-count-1'}}
            )
+scss.
   .section-vehicle-info {
      margin-bottom: 1rem; 
      label-input {
         display: grid;
         grid-template-columns: auto 4rem;
      }
      &__vehicle-name {
         display: flex;
         justify-self: center;
         margin-bottom: 0.5rem;
         font-size: 200%;
         text-align: center;
         font-variant-caps: small-caps;
      }
      &__vehicle-info {
         background-color: transparent;
         display: grid;
         grid-template-columns: 1fr 1fr;
         column-gap: 1rem; 
         label.input-label.input-label-text {
            text-indent: 0.5rem; 
            padding-right: 0.75rem; 
            display: grid;
            grid-template-columns: auto 1fr; 
            span {
               padding-right: 0.75rem;
            }
            input[type=text] {
               width: 100%; 
            }
         }
      }

   }