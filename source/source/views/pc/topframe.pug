mixin topframe
   .section-topframe 
      +attributes 
      +charinfo 
      +derived
+scss.
   .section-topframe {
      align-content: top; 
      display: grid;
      grid-template-columns: 1fr 3fr;
      grid-template-areas: "attr info"
                           "attr derived";
      & + div:first-of-type { grid-area: attr; }
      & + div:nth-of-type(2) { grid-area: info; }
      & + div:last-of-type { grid-area: derived; }
      * { border: 1px solid black; }
   }