mixin skill-list
   - skills = spine.skills_primary
   each skill in skills 
      - const labelObj = {class:'label-input-label',attr:skill.attr,name: skill.name,type: skill.type};
      +label-inputs({
         label: skill.name + ' (' + skill.base_abbr + ')',
         divObj: {class:'skill-row column-'+skill.attr},
         labelObj,
         inputObj: [
            {type: 'button',name:skill.attr,class:'',trigger:{triggeredFuncs:['']}},                     
            {type: 'number', name: skill.attr, class:'label-input-input input-'+skill.name,trigger:{triggeredFuncs:[skill.trigger]}},
            {type: 'number', name: skill.attr+'_mod', class:'label-input-input input-'+skill.name+'-mod'},
            {type: 'number', name: skill.attr+'_exp', class:'label-input-input input-'+skill.name+'-exp'}
         ]
      })