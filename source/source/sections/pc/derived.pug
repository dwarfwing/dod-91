
mixin derived
   .section-derived 
      .section-derived__abilities
         .section-header
            span Abilitiies
         .section-content
            span Repeating section 
      .section-derived__stats 
         +input-label({
               label: 'SB',
               inputObj: { type: 'number', name: 'damagebonus' },
               divObj: { class: 'section-derived__damagebonus' }
            })
         +input-label({
               label: 'BRF',
               inputObj: { type: 'number', name: 'carrycap' },
               divObj: { class: 'section-derived__carrycap' }
            })
         +input-label({
               label: 'Förfl',
               inputObj: { type: 'number', name: 'movement' },
               divObj: { class: 'section-derived__movement' }
            })
         +input-label({
               label: 'Hjältepoäng',
               inputObj: { type: 'number', name: 'heropoints' },
               divObj: { class: 'section-derived__heropoints' }
            })
      .section-derived__points
         .section-derived__points__hit
            .section-header
               span Kroppspoäng
            .section-content
         .section-derived__points__psy
            .section-header
               span Psyke-poäng
            .section-content
+scss.
   .section-derived {
      display: grid; 
      grid-area: derived; 
      grid-template-columns: 1fr 1fr 1fr; 
   }