mixin charinfo 
   .section-charinfo 
      .section-content
         each info in spine.charinfo 
            +input-label({
               label: info.name,
               inputObj: { name: info.attr, type: 'text'},
               divObj: {class: 'section-charinfo__charinfo-field text-field'}
            })
      //-.section-bottom 
         +textarea({name:'appearance',placeholder:'Utseende'})
+scss.
   .section-charinfo {
      grid-area: info; 
      
      .section-content { 
         display: grid; 
         grid-template-areas: "spelare spelare spelare sl sl sl"
                     "namn namn namn namn namn namn"
                     "ras ras kon kon stand stand"
                     "prof prof hand hand age age"
                     "appear appear appear appear appear appear";
         .input-label {
            position: relative; 
            label {
               position: absolute;
               top: 0;
               left: 0;
               font-size: 40%; 
            }
         }
         label:nth-of-type(1) { grid-area: spelare; }
         label:nth-of-type(2) { grid-area: sl; }
         label:nth-of-type(3) { grid-area: namn; }
         label:nth-of-type(4) { grid-area: ras; }
         label:nth-of-type(5) { grid-area: kon; }
         label:nth-of-type(6) { grid-area: stand; }
         label:nth-of-type(7) { grid-area: prof; }
         label:nth-of-type(8) { grid-area: hand; }
         label:nth-of-type(9) { grid-area: age; }
         label:nth-of-type(10) { grid-area: appear; }
         
      }
   }