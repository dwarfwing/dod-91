mixin attributes 
   .section-attributes  
      .section-header.attribute-grid 
         span Grundegenskap 
         span Värde
      .section-content
         each attribute in spine.attributes
            - lbl = attribute.name + ' (' + attribute.abbr + ')'; 
            +input-label({
               label: lbl,
               inputObj: { type: 'number', name: attribute.attr },
               divObj: { class: 'section-attributes__attribute-row attribute-grid' }
            })
+scss.
   .section-attributes {
      grid-area: attr;
      height: 100%;  
   }